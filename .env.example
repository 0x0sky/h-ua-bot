# h-ua-bot settings. Copy to .env and load it into the process environment.
# Required to run: HUA_TELEGRAM_TOKEN, HUA_HUB_ORIGIN, HUA_HUB_TOKEN, HUA_DELIVERY_SECRET.

# Bot token from @BotFather. A credential: never commit it, never log it.
HUA_TELEGRAM_TOKEN=

# The prism-hub this bot is a client of, and this bot's credential there. The credential's
# principal needs: actors:onboard, actors:resolve, bot_instances:read, bot_instances:manage,
# alert_subscriptions:read, alert_subscriptions:manage. A credential: never commit it.
HUA_HUB_ORIGIN=https://hub.example
HUA_HUB_TOKEN=

# The secret the hub sends with every delivery (its PRISM_BOT_DELIVERY_SECRET). At least 32
# characters. A credential: never commit it.
HUA_DELIVERY_SECRET=

# Where the hub's delivery endpoint listens. The hub delivers over https, so put a TLS proxy in
# front of this and point the hub's PRISM_BOT_ORIGIN at the proxy.
HUA_DELIVERY_LISTEN=0.0.0.0:8080

# Which bot people are known as at the hub, and the hub's logical channel their chats are bound
# to. The hub's PRISM_SIGNAL_ALERT_CHANNEL must be the same channel.
HUA_HUB_PROVIDER_SCOPE=h-ua-bot
HUA_ALERT_CHANNEL=alerts

# Channels named to people as where alerts come from, comma separated. This is only what the bot
# says: which sources the hub reads is the hub's PRISM_SIGNAL_SOURCES_JSON.
HUA_SOURCES=vanek_nikolaev

# Only for a local Bot API server.
# HUA_TELEGRAM_API_BASE=http://127.0.0.1:8081

# Logging, in tracing's filter syntax.
# RUST_LOG=info
