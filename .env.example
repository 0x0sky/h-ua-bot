# h-ua-bot settings. Copy to .env and load it into the process environment.
# Only HUA_TELEGRAM_TOKEN is required; everything else has a default.

# Bot token from @BotFather. A credential: never commit it, never log it.
HUA_TELEGRAM_TOKEN=

# Telegram channels to read, comma separated, without the t.me/ prefix. Public channels with a
# web preview (t.me/s/<name>) only.
HUA_SOURCES=vanek_nikolaev

# Where the SQLite database lives. Created on first start, readable by its owner only.
HUA_DB_PATH=var/h-ua.sqlite

# Seconds between two reads of a source. Not below 15: the channel preview is a public
# courtesy, not an API with a quota.
HUA_POLL_SECS=30

# A post older than this many seconds is never relayed, so a restart cannot wake anyone with a
# threat that is long over.
HUA_MAX_AGE_SECS=900

# The same kind of threat at the same place is not repeated within this many seconds.
HUA_COOLDOWN_SECS=180

# An all-clear reaches people who were alerted within this many seconds.
HUA_CLEARED_WINDOW_SECS=3600

# Quote the source's own words in an alert. false: only the summary and the link.
HUA_INCLUDE_TEXT=true

# Only for a local Bot API server.
# HUA_TELEGRAM_API_BASE=http://127.0.0.1:8081

# Logging, in tracing's filter syntax.
# RUST_LOG=info
